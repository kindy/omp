// Static-only Cloudflare Workers deployment of packages/collab-web.
// `./dist` is produced by `bun run build` (scripts/build.ts), not by collab-web.
// No Worker script and no relay: guests connect to the relay named in their
// link (default wss://my.omp.sh). See README.md.
{
	"name": "omp-omy",
	"compatibility_date": "2026-10-28",
	"assets": {
		"directory": "./dist"
	},
	"routes": [
		{
			"pattern": "omy.hon.sh",
			"zone_name": "hon.sh",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": true
		}
	],
	"workers_dev": false,
	"preview_urls": false,
	// Previews do not inherit top-level settings; a static site needs none.
	"previews": {}
}
